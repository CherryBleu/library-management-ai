@startuml
title Library Management System - Use Case Model
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor Reader
actor Student
actor Teacher
actor Librarian
actor SystemAdmin

Student --|> Reader
Teacher --|> Reader

rectangle "Library Management System" {
  usecase "Register account" as UC_Register
  usecase "Search library items" as UC_Search
  usecase "Reserve library item" as UC_Reserve
  usecase "View loan history" as UC_ViewLoan

  usecase "Borrow item" as UC_Borrow
  usecase "Return item" as UC_Return
  usecase "Validate borrow card" as UC_ValidateCard
  usecase "Check borrowing policy" as UC_CheckPolicy
  usecase "Check overdue loans" as UC_CheckOverdue
  usecase "Validate local collection" as UC_ValidateCollection
  usecase "Calculate overdue fine" as UC_CalculateFine

  usecase "Issue borrow card" as UC_IssueCard
  usecase "Remove borrow card" as UC_RemoveCard
  usecase "Add librarian" as UC_AddLibrarian
  usecase "Remove librarian" as UC_RemoveLibrarian
  usecase "Add book title" as UC_AddTitle
  usecase "Remove book title" as UC_RemoveTitle
  usecase "Add library item" as UC_AddItem
  usecase "Remove library item" as UC_RemoveItem
  usecase "Maintain borrowing rules" as UC_MaintainBorrowPolicy
  usecase "Maintain fine rules" as UC_MaintainFineRule
  usecase "Maintain system administrators" as UC_MaintainAdmin
}

Reader --> UC_Register
Reader --> UC_Search
Reader --> UC_Reserve
Reader --> UC_ViewLoan

Librarian --> UC_Borrow
Librarian --> UC_Return
Librarian --> UC_ViewLoan

SystemAdmin --> UC_IssueCard
SystemAdmin --> UC_RemoveCard
SystemAdmin --> UC_AddLibrarian
SystemAdmin --> UC_RemoveLibrarian
SystemAdmin --> UC_AddTitle
SystemAdmin --> UC_RemoveTitle
SystemAdmin --> UC_AddItem
SystemAdmin --> UC_RemoveItem
SystemAdmin --> UC_MaintainBorrowPolicy
SystemAdmin --> UC_MaintainFineRule
SystemAdmin --> UC_MaintainAdmin

UC_Borrow ..> UC_ValidateCard : <<include>>
UC_Borrow ..> UC_CheckPolicy : <<include>>
UC_Borrow ..> UC_CheckOverdue : <<include>>
UC_Borrow ..> UC_ValidateCollection : <<include>>
UC_Return ..> UC_ValidateCollection : <<include>>
UC_Return ..> UC_CalculateFine : <<include>>
UC_CalculateFine ..> UC_CheckOverdue : <<include>>

UC_Reserve ..> UC_Search : <<include>>
UC_Reserve ..> UC_ValidateCard : <<include>>

note right of UC_Borrow
  Borrowing is performed by a librarian
  on behalf of a reader.
end note

note bottom of UC_CheckPolicy
  The policy depends on reader type,
  current loan count and loan period.
end note
@enduml
